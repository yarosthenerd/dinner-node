# DinnerNode node configuration.
#
# Copy to .env and fill in what you need. Every value here has a working
# default except PROVIDER_PK, which is the only one the node cannot invent.
# Nothing in this file is a secret; .env itself is gitignored because it holds
# the key.

# ---- identity and chain -----------------------------------------------------

# The provider wallet. This key signs registerProvider, settle and closeJob, so
# it needs testnet MON for gas. The node refuses to serve when its balance
# falls below the floor, because tokens it cannot settle are tokens it serves
# for free.
PROVIDER_PK=0x

# The registry. Defaults to DinnerNodeV2 on Monad testnet; set it only to point
# at a different deployment.
# DINNER_NODE_ADDRESS=0xcf642a144f3cb1159b05563506698fc2db375029

# For running the whole daemon against a local anvil, end to end, with real
# transactions and no testnet MON. Unset in normal use.
# RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337

# ---- engine -----------------------------------------------------------------

# The ollama tag to serve. If it is not installed the node REFUSES TO START
# rather than falling back: this string goes on chain in the provider record
# and the price is resolved from this model's market band, so serving a
# different one would be wrong three ways at once. Unset takes the first
# installed tag and says which.
# MODEL=qwen3.8:27b

# An OpenAI-compatible server instead of ollama: LM Studio, vLLM, llama.cpp,
# anything speaking /v1/chat/completions. `npm run setup` writes both of these
# for you when it finds LM Studio running, so setting them by hand is for a
# server setup does not probe.
#
# LLM_MODEL is not optional in spirit even though it is in fact. Unset, the
# node asks the server what it holds and serves that, which is right when the
# server holds exactly one model and refuses to start when it holds several:
# this string goes on chain as the provider's advertised weights and decides
# the price, so it is not a thing to guess at. It used to default to the
# literal "local", which is not a model and prices against nothing.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen/qwen3-8b

# LM Studio's server, when it is not on the port it ships with. Only setup
# reads this; the node itself talks to whatever LLM_BASE_URL says.
# LMSTUDIO_URL=http://localhost:1234

# Extra ports for setup to look for an engine on, beyond the ones it knows
# (LM Studio 1234, KoboldCpp 5001, llama.cpp 8080, Jan 1337, vLLM 8000,
# text-generation-webui 5000, GPT4All 4891). A server found this way is
# accepted on the same terms as any other, which is to say only if it answers
# /v1/models with a model list, and it is never named: nothing on the wire
# says what it is. Setup only.
# ENGINE_PORTS=9000,9001

# Context window, and how much of it is reserved for the answer. 32768 is the
# session-shape decision, not a hardware ceiling: 95k fits on the reference
# machine. Changing num_ctx forces a model reload, which is what time to first
# token is actually paying for.
#
# On LM Studio this number cannot exceed what the model was loaded with. The
# context lives in the loaded instance there, not in the request, so a node
# advertising more than the engine serves gets its prompts truncated in
# silence and is paid for answering a question the model never fully saw.
# Setup reads the loaded length and offers to lower this to match.
# CONTEXT_TOKENS=32768
# OUTPUT_RESERVE_TOKENS=2048

# ---- price ------------------------------------------------------------------

# Where in the market band this node sits. The rate is resolved against the
# same public listing a buyer would check, rather than typed in by hand.
# PRICE_POLICY=median
# PRICE_DISCOUNT=1
# MON_USD=0.03

# An explicit rate in wei per million tokens. Setting a price is a decision, so
# this always wins over the band.
# RATE_PER_MILLION=26700000000000000000

# ---- reachability -----------------------------------------------------------

# The URL other machines reach this node at. Set it to a named tunnel or any
# arrangement you made yourself. Left unset, the node starts a cloudflared
# quick tunnel at boot and uses the hostname it gets, which is new on every
# restart. TUNNEL=off to never start one.
#
# The binary is whichever cloudflared is on your PATH, and failing that the one
# `npm run setup` offers to fetch into bin/. With neither, and no PUBLIC_URL,
# the node serves its own LAN and earns nothing from the network; setup says so
# rather than calling itself ready.
# PUBLIC_URL=https://node1.dinnernode.xyz
# TUNNEL=auto

# Where to announce that URL. The announcement is signed: discovery issues a
# nonce, this node signs a claim naming the registry, chain, itself, its URL
# and its model, and an announcement without that signature is refused.
# DISCOVERY_URL=https://discovery.dinnernode.xyz

# ---- who may spend this node's money ----------------------------------------

# /lanjob opens a job THIS NODE pays for, which is what makes the LAN guest
# page work with no wallet. It was safe only because nobody outside the network
# could reach the port, and a tunnel ends that: every tunnelled request arrives
# from 127.0.0.1. So the check is a private peer AND no forwarding header.
#   lan   (default) this network only
#   off   nobody
#   open  anyone who can reach the port, which behind a tunnel is everyone
# LANJOB=lan

# The OpenAI-compatible endpoint at /v1/chat/completions. OFF unless keys are
# set, because a caller there holds a key rather than a wallet and the node
# fronts the escrow from its own deposit. Comma separated.
# API_KEYS=dn-live-...,dn-test-...

# What that endpoint may bill in a rolling day. In memory, so it resets on
# restart: a brake on a runaway client, not an accounting system.
# V1_DAILY_TOKENS=2000000

# What the node escrows per fronted job, and what it deposits when the float
# runs dry. Closing a job returns the unspent part, so the top-up is a float
# rather than a cost.
# FRONT_BUDGET_MON=0.01
# FRONT_TOPUP_MON=0.1

# ---- the aggregator catalog at /provider/models -----------------------------

# Whether this node wants routed traffic. False until you say so, because a
# node that lists itself ready on the day it is installed gets traffic it has
# never served.
# PROVIDER_IS_READY=1

# Where the machine is. Declared only if you set it, and it is published.
# DATACENTER_COUNTRY=RS
# DATACENTER_REGION=belgrade

# ---- load and behaviour -----------------------------------------------------

# Who loses when the machine is busy. "owner" throttles guests early so the
# person at the keyboard wins; "guest" only backs off near saturation.
# HOST_PRIORITY=owner
# MAX_CONCURRENT_JOBS=2

# How long a session job may sit idle before the provider closes it and returns
# the guest's unspent escrow.
# SESSION_IDLE_MS=600000

# The serving instruction sent with every job. It occupies context like any
# other text, so it is charged against the prompt budget.
# SYSTEM_PROMPT=
