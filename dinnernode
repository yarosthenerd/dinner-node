#!/bin/sh
# DinnerNode node, one command. Linux and macOS; Windows is dinnernode.cmd.
#
#   git clone <repo> && cd dinnernode && ./dinnernode
#
# Installs dependencies if needed, runs setup (idempotent, only writes what is
# missing), and serves. Ctrl-C stops everything, tunnel included.
#
# POSIX sh on purpose: this is the first thing a new operator runs, and it has
# to work before anything about their machine is known. For the same reason it
# holds no logic of its own. Dependency freshness is scripts/deps-stale.mjs and
# the public tunnel is src/tunnel.ts, both shared with dinnernode.cmd, because
# a rule that lives in two shells is a rule that will differ in two shells.
set -eu

cd "$(dirname "$0")"

if [ -t 1 ]; then B='\033[1m'; D='\033[2m'; X='\033[0m'
else B=''; D=''; X=''; fi

say() { printf "%b\n" "$1"; }
die() { printf "%b\n" "\033[31m✗${X} $1" >&2; exit 1; }

command -v node >/dev/null 2>&1 || die "node is not installed. Get it from https://nodejs.org (version 20 or newer)."
command -v npm  >/dev/null 2>&1 || die "npm is not installed. It ships with node: https://nodejs.org"

# ---- dependencies ---------------------------------------------------------
if node scripts/deps-stale.mjs; then
  say "${B}installing dependencies${X} ${D}(first run takes a minute)${X}"
  npm install --no-audit --no-fund
  # Keep the marker fresh so the next run skips this.
  touch node_modules
fi

# ---- setup ----------------------------------------------------------------
# Interactive and idempotent. Exits nonzero if the node is not ready to serve,
# having already printed what to fix.
npm run --silent setup || exit 1

# ---- serve ----------------------------------------------------------------
# The node opens its own cloudflared quick tunnel when PUBLIC_URL is unset and
# TUNNEL is not "off", and kills it on the way out. This script used to start a
# second one and export the hostname, which meant two implementations of the
# same thing and, on a machine with both, two tunnels onto one port.
say ""
exec npm run --silent host
